{
  "name": "blackjack-antefall",
  "version": "1.0.2",
  "description": "BLACKJACK: ANTEFALL packaged as an Electron desktop game.",
  "main": "electron-main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win dir",
    "portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.blackjackantefall.game",
    "productName": "BLACKJACK ANTEFALL",
    "files": [
      "electron-main.js",
      "index.html",
      "carddraw.mp3",
      "lose.mp3",
      "Winsound.mp3"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1"
  }
}
